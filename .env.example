# ========================================================
# BIKOPA (Bis Kota Palu) - Environment Configuration
# ========================================================

# 1. URL Proyek Supabase Anda (Dapatkan dari Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public Anon Key (Dapatkan dari Project Settings -> API)
# Kunci ini aman untuk publik browser karena dibatasi oleh Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Service Role Key (RAHASIA: Hanya untuk Server / Telemetry Ingest)
# JANGAN PERNAH menyebarkan kunci ini ke publik atau commit ke git!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
